{
  "name": "@kirora/cli",
  "version": "0.2.0",
  "description": "The Kirora API from your terminal: contacts, messages, webhooks and more.",
  "keywords": [
    "kirora",
    "cli",
    "email",
    "marketing",
    "webhooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiroratech/kirora-cli.git"
  },
  "homepage": "https://kirora.io/docs/sdks/cli",
  "bugs": {
    "url": "https://github.com/kiroratech/kirora-cli/issues"
  },
  "type": "module",
  "bin": {
    "kirora": "dist/bin.js"
  },
  "files": [
    "dist",
    "docs/usage.md",
    "skills",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "codegen": "node scripts/codegen.mjs",
    "start": "tsx src/bin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen:check": "node scripts/codegen.mjs --check",
    "check:package": "node scripts/check-package.mjs",
    "smoke": "pnpm build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@inquirer/confirm": "^6.3.5",
    "@inquirer/password": "^5.2.3",
    "@kirora/node": "^0.2.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@8.6.0"
}
